{
  "name": "portfolio-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm install",
    "build": "tsc --noEmit && node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "knip": "npx --yes knip",
    "ts-prune": "npx --yes ts-prune",
    "validate:dead-code": "npm run knip && npm run ts-prune"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "crypto-js": "^4.2.0",
    "preact": "^11.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wrangler": "^4.149.0"
  }
}
