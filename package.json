{
  "name": "portfolio-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "knip": "npx --yes knip",
    "validate:dead-code": "npm run knip",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.13.10",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "preact": "^11.0.1"
  }
}
