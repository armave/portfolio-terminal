{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "PORTFOLIO_KV",
      "id": "01c5f86edd6b4307b82d54b316ec6bdd"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PORTFOLIO_STATE_DO",
        "class_name": "PortfolioStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PortfolioStateDO"
      ]
    }
  ],
  // Stable namespace for this Worker. The binding is approximate and location-local;
  // route-qualified keys keep authentication counters separate from other resources.
  "ratelimits": [
    {
      "name": "AUTH_EDGE_RATE_LIMITER",
      "namespace_id": "28103110320261103",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "AUTH_EDGE_LIMITER_REQUIRED": "true"
  }
}
